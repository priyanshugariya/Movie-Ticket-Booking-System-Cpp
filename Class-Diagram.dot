digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.8, bgcolor="white"];
  node [shape=record, fontname="Arial", fontsize=9];
  edge [fontname="Arial", fontsize=8];
  Movie [label="{Movie| - title : string\\l - language : string\\l - durationMinutes : int\\l| + getTitle()\\l + getLanguage()\\l + getDuration()\\l}"];
  Seat [label="{Seat| - number : string\\l - type : SeatType\\l| + getNumber()\\l + getType()\\l + getPrice()\\l}"];
  Screen [label="{Screen| - screenNumber : int\\l - seats : vector<Seat>\\l| + addSeat()\\l + getSeats()\\l}"];
  Cinema [label="{Cinema| - name : string\\l - screens : vector<Screen>\\l| + addScreen()\\l + getScreens()\\l}"];
  Show [label="{Show| - showId : int\\l - movie : Movie*\\l - screen : Screen*\\l - startTime : string\\l - showSeats : vector<ShowSeat>\\l| + findSeat()\\l + displaySeats()\\l}"];
  ShowSeat [label="{ShowSeat| - seat : Seat*\\l - status : SeatStatus\\l| + isAvailable()\\l + bookSeat()\\l + cancelSeat()\\l}"];
  Customer [label="{Customer| - name : string\\l - phone : string\\l| + getName()\\l + getPhone()\\l}"];
  Booking [label="{Booking| - nextBookingId : static int\\l - bookingId : int\\l - customer : Customer\\l - show : Show*\\l - seats : vector<ShowSeat*>\\l - totalAmount : double\\l - status : BookingStatus\\l| + confirm()\\l + fail()\\l + cancel()\\l}"];
  Payment [label="{Payment (abstract)| | + pay(amount : double) = 0\\l + getMethodName() = 0\\l}"];
  UpiPayment [label="{UpiPayment| - upiId : string\\l| + pay(amount)\\l + getMethodName()\\l}"];
  CardPayment [label="{CardPayment| - cardNumber : string\\l| + pay(amount)\\l + getMethodName()\\l}"];
  CashPayment [label="{CashPayment| | + pay(amount)\\l + getMethodName()\\l}"];
  PriceCalculator [label="{PriceCalculator| | + calculateTotal(seats) : double\\l}"];
  TicketPrinter [label="{TicketPrinter| | + printTicket(booking) : void\\l}"];
  BookingService [label="{BookingService| - priceCalculator : PriceCalculator\\l - ticketPrinter : TicketPrinter\\l - bookings : vector<Booking>\\l| + createBooking() : Booking\\l + cancelBooking() : void\\l}"];

  Cinema -> Screen [label="1 *-- 1..*", arrowhead=diamond];
  Screen -> Seat [label="1 *-- 1..*", arrowhead=diamond];
  Show -> Movie [label="1 o-- 1", arrowhead=odiamond];
  Show -> Screen [label="1 -- 1", arrowhead=none];
  Show -> ShowSeat [label="1 *-- 1..*", arrowhead=diamond];
  Booking -> Customer [label="1 -- 1", arrowhead=none];
  Booking -> ShowSeat [label="1 o-- 1..*", arrowhead=odiamond];
  Booking -> Payment [label="1 -- 1", arrowhead=none];
  Payment -> UpiPayment [arrowhead=onormal];
  Payment -> CardPayment [arrowhead=onormal];
  Payment -> CashPayment [arrowhead=onormal];
  BookingService -> Booking [label="1 o-- 0..*", arrowhead=odiamond];
}
